<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:vm="using:WgetUi.App.ViewModels"
             xmlns:v="using:WgetUi.App.Views"
             x:Class="WgetUi.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://wgetui/Themes/SourceBadges.axaml" />
        <ResourceInclude Source="avares://wgetui/Themes/AppColors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <sty:FluentAvaloniaTheme PreferSystemTheme="True" />
    <Style Selector="TextBlock.PageTitle">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.Secondary">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.RowTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Versions can be very long (e.g. Spotify "1.3.8.620.g39b276d5d7ac"): cap them so a version
         column can't starve the name column or push the action button out of the row. -->
    <Style Selector="TextBlock.Version">
      <Setter Property="MaxWidth" Value="260" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The (i) details button left of each row's action. -->
    <Style Selector="Button.Info">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource InfoButtonForeground}" />
      <!-- Shown only on the highlighted row: hover, selection or keyboard focus. Opacity, not IsVisible, so the
           row layout doesn't shift and the button stays reachable with Tab. -->
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.Info, ListBoxItem:selected Button.Info, ListBoxItem:focus-within Button.Info">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- The automatic-update toggle left of (i): off = grey and only on the highlighted row (like Button.Info);
         on (.On) = accent-tinted and always visible; forced = on plus a small amber dot (Border.AutoUpdateForced). -->
    <Style Selector="Button.AutoUpdate">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.AutoUpdate Path">
      <Setter Property="Stroke" Value="{DynamicResource AutoUpdateOffForeground}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.AutoUpdate, ListBoxItem:selected Button.AutoUpdate, ListBoxItem:focus-within Button.AutoUpdate">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.AutoUpdate.On">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AutoUpdateOnBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AutoUpdateOnBorder}" />
    </Style>
    <Style Selector="Button.AutoUpdate.On Path">
      <Setter Property="Stroke" Value="{DynamicResource AutoUpdateOnForeground}" />
    </Style>
    <Style Selector="Border.AutoUpdateForced">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Margin" Value="0,0,-4,-4" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Background" Value="{DynamicResource AutoUpdateForcedBackground}" />
    </Style>
    <Style Selector="Border.AutoUpdateForced Path">
      <Setter Property="Stroke" Value="{DynamicResource AutoUpdateForcedForeground}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
  </Application.Styles>

  <!-- Page view models → views. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:SearchViewModel"><v:SearchView /></DataTemplate>
    <DataTemplate DataType="vm:UpdatesViewModel"><v:UpdatesView /></DataTemplate>
    <DataTemplate DataType="vm:InstalledViewModel"><v:InstalledView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
  </Application.DataTemplates>
</Application>
