<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:WgetUi.App.ViewModels"
             xmlns:l="using:WgetUi.App.Localization"
             x:Class="WgetUi.App.Views.QueuePanel"
             x:DataType="vm:OperationsViewModel"
             IsVisible="{Binding IsPanelVisible}">
  <!-- Transparent pane on the window (Mica) background, like the left navigation pane. -->
  <Border Background="Transparent">
    <Panel>
      <!-- Collapsed: a narrow strip with the number of pending operations. -->
      <Button IsVisible="{Binding IsCollapsed}" Command="{Binding ToggleExpandedCommand}"
              Width="48" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
              Background="Transparent" BorderThickness="0" Padding="0,12"
              ToolTip.Tip="{l:Tr Queue_Expand}">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <ui:FASymbolIcon Symbol="Download" FontSize="16" />
          <ui:FAInfoBadge Value="{Binding PendingCount}" IsVisible="{Binding HasPending}" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Expanded: compact list of operations. -->
      <Grid IsVisible="{Binding IsExpanded}" Width="300" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="12,10,6,6" ColumnSpacing="4">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="RowTitle" Text="{l:Tr Queue_Title}" />
            <ui:FAInfoBadge Value="{Binding PendingCount}" IsVisible="{Binding HasPending}" />
          </StackPanel>
          <Button Grid.Column="1" Content="{l:Tr Queue_Clear}" Command="{Binding ClearFinishedCommand}" IsVisible="{Binding HasFinished}" Padding="8,2" />
          <Button Grid.Column="2" Command="{Binding ToggleExpandedCommand}" ToolTip.Tip="{l:Tr Queue_Collapse}"
                  Background="Transparent" BorderThickness="0" Padding="6,2">
            <TextBlock Text="»" FontSize="16" />
          </Button>
        </Grid>
        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Items}" Margin="8,0,8,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OperationItemViewModel">
                <Border Background="Transparent" CornerRadius="4" Padding="10,6" Margin="0,0,0,2">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="RowTitle" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Id}" />
                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}"
                            ToolTip.Tip="{l:Tr Ops_Cancel}" Background="Transparent" BorderThickness="0" Padding="6,2" VerticalAlignment="Top">
                      <ui:FASymbolIcon Symbol="Dismiss" FontSize="12" />
                    </Button>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                      <TextBlock Classes="Secondary" FontSize="12" Text="{Binding KindText}" />
                      <TextBlock Classes="Secondary" FontSize="12" Text="·" />
                      <TextBlock FontSize="12" Text="{Binding StateText}" />
                      <TextBlock Classes="Secondary" FontSize="12" Text="{Binding StageText}" IsVisible="{Binding IsRunning}" />
                      <TextBlock Classes="Secondary" FontSize="12" Text="{Binding PercentText}" IsVisible="{Binding HasPercent}" />
                    </StackPanel>
                    <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" MinHeight="3" Height="3"
                                 Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding IsRunning}" />
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                      <TextBlock FontSize="12" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource SystemFillColorCriticalBrush}" ToolTip.Tip="{Binding ErrorText}" />
                      <TextBlock Classes="Secondary" FontSize="12" Text="{l:Tr Ops_RebootRequired}" IsVisible="{Binding RebootRequired}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Panel>
  </Border>
</UserControl>
