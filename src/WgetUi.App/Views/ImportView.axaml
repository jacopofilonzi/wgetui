<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:WgetUi.App.ViewModels"
             xmlns:l="using:WgetUi.App.Localization"
             x:Class="WgetUi.App.Views.ImportView"
             x:DataType="vm:ImportViewModel"
             Width="720">
  <UserControl.Styles>
    <!-- Status pills: colour and text (never colour alone), from theme resources (Themes/AppColors.axaml). -->
    <Style Selector="Border.Status">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource ImportStatus.Checking.Background}" />
    </Style>
    <Style Selector="Border.Status TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ImportStatus.Checking.Foreground}" />
    </Style>
    <Style Selector="Border.Status.ToInstall">
      <Setter Property="Background" Value="{DynamicResource ImportStatus.ToInstall.Background}" />
    </Style>
    <Style Selector="Border.Status.ToInstall TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ImportStatus.ToInstall.Foreground}" />
    </Style>
    <Style Selector="Border.Status.Installed">
      <Setter Property="Background" Value="{DynamicResource ImportStatus.Installed.Background}" />
    </Style>
    <Style Selector="Border.Status.Installed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ImportStatus.Installed.Foreground}" />
    </Style>
    <Style Selector="Border.Status.Problem">
      <Setter Property="Background" Value="{DynamicResource ImportStatus.Problem.Background}" />
    </Style>
    <Style Selector="Border.Status.Problem TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ImportStatus.Problem.Foreground}" />
    </Style>
    <Style Selector="Border.Status.Unavailable">
      <Setter Property="Background" Value="{DynamicResource ImportStatus.Unavailable.Background}" />
    </Style>
    <Style Selector="Border.Status.Unavailable TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ImportStatus.Unavailable.Foreground}" />
    </Style>
    <Style Selector="TextBlock.ColumnHeader">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
  </UserControl.Styles>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Header: file icon, title, "source · N packages · exported on <date>", close. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="24,24,24,0">
      <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource PackageTileBackground}" VerticalAlignment="Top">
        <ui:FASymbolIcon Symbol="Document" FontSize="24" Foreground="{DynamicResource PackageTileForeground}" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="{l:Tr Import_Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Classes="Secondary" Text="{Binding Subtitle}" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="2" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
              Command="{Binding CloseCommand}" ToolTip.Tip="{l:Tr Details_Close}" AutomationProperties.Name="{l:Tr Details_Close}">
        <ui:FASymbolIcon Symbol="Dismiss" FontSize="14" />
      </Button>
    </Grid>

    <!-- Version mode (segmented) + hint, select all and the column headers. -->
    <StackPanel Grid.Row="1" Spacing="12" Margin="24,20,24,8" IsVisible="{Binding HasList}">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="0">
          <ToggleButton Content="{l:Tr Import_ModeLatest}" IsChecked="{Binding IsLatestMode, Mode=OneWay}" Command="{Binding SetLatestModeCommand}"
                        CornerRadius="4,0,0,4" MinWidth="150" />
          <ToggleButton Content="{l:Tr Import_ModePinned}" IsChecked="{Binding IsPinnedMode, Mode=OneWay}" Command="{Binding SetPinnedModeCommand}"
                        CornerRadius="0,4,4,0" MinWidth="150" />
        </StackPanel>
        <TextBlock Classes="Secondary" FontSize="12" Text="{Binding ModeHint}" TextWrapping="Wrap" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*,140,170" ColumnSpacing="12" IsVisible="{Binding !ShowEmpty}">
        <CheckBox Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding SelectAll}" IsEnabled="{Binding CanSelectAll}" Content="{l:Tr List_SelectAll}" />
        <TextBlock Grid.Column="2" Classes="ColumnHeader" Text="{l:Tr Import_ColumnVersion}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="3" Classes="ColumnHeader" Text="{l:Tr Import_ColumnStatus}" VerticalAlignment="Center" />
      </Grid>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
    </StackPanel>

    <Panel Grid.Row="2">
      <TextBlock Classes="Secondary" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Margin="24,20,24,8" />
      <TextBlock Classes="Secondary" Text="{l:Tr Import_Empty}" IsVisible="{Binding ShowEmpty}" TextWrapping="Wrap" Margin="24,8" />
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Rows}" Margin="24,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ImportRowViewModel">
              <Grid ColumnDefinitions="Auto,*,140,170" ColumnSpacing="12" Margin="0,4">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="{Binding Name}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="RowTitle" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Classes="Secondary" Text="{Binding IdLine}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding IdLine}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Classes="Version" Text="{Binding MainVersion}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MainVersion}" />
                  <TextBlock Classes="Secondary" FontSize="12" Text="{Binding OtherVersion}" IsVisible="{Binding HasOtherVersion}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                  <Border Classes="Status" Classes.ToInstall="{Binding IsToInstall}" Classes.Installed="{Binding IsInstalled}"
                          Classes.Problem="{Binding IsProblem}" Classes.Unavailable="{Binding IsUnavailable}">
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
                  </Border>
                  <TextBlock Classes="Secondary" FontSize="12" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>

    <!-- Footer: "N of M selected", Cancel, Install selected (N). Nothing is queued before that click. -->
    <Border Grid.Row="3" Margin="0,12,0,0" Padding="24,16" Background="{DynamicResource DetailsFooterBackground}" BorderBrush="{DynamicResource DetailsCardBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Classes="Secondary" Text="{Binding SelectedText}" VerticalAlignment="Center" IsVisible="{Binding HasList}" />
        <Button Grid.Column="1" Content="{l:Tr Common_Cancel}" Command="{Binding CloseCommand}" MinWidth="96" />
        <Button Grid.Column="2" Classes="accent" Content="{Binding InstallText}" Command="{Binding InstallCommand}" IsVisible="{Binding HasList}" MinWidth="96" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
