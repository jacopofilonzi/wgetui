<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:WgetUi.App.ViewModels"
        xmlns:l="using:WgetUi.App.Localization"
        xmlns:v="using:WgetUi.App.Views"
        x:Class="WgetUi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="wgetui" Icon="/Assets/wgetui.ico" Width="1360" Height="760" MinWidth="720" MinHeight="480"
        TransparencyLevelHint="Mica">
  <Window.Resources>
    <!-- The content card sits between two panes, so round both top corners (FluentAvalonia
         reads these through DynamicResource; defaults are 8,0,0,0 and 1,1,0,0). -->
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,8,0,0</CornerRadius>
    <Thickness x:Key="NavigationViewContentGridBorderThickness">1,1,1,0</Thickness>
  </Window.Resources>
  <Grid RowDefinitions="Auto,*">
    <ui:FAInfoBar Grid.Row="0" Margin="12,8,12,0" Severity="Error" IsClosable="True"
                  IsOpen="{Binding IsBannerOpen, Mode=TwoWay}"
                  Title="{l:Tr Banner_ManagerUnavailable}"
                  Message="{Binding BannerMessage}" />
    <!-- Queue panel outside the content card, on the window background like the left pane. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
    <ui:FANavigationView Grid.Column="0" x:Name="Nav" PaneDisplayMode="Auto" IsSettingsVisible="False"
                         IsBackButtonVisible="False" OpenPaneLength="220">
      <!-- Default window width (1360) leaves the nav ≥ ExpandedModeThresholdWidth (1008) even with the 300 px queue panel open, so queuing an operation doesn't collapse the menu. -->
      <ContentControl Content="{Binding CurrentPage}" />
      <ui:FANavigationView.MenuItems>
        <ui:FANavigationViewItem Content="{l:Tr Nav_Search}" Tag="search">
          <ui:FANavigationViewItem.IconSource><ui:FASymbolIconSource Symbol="Find" /></ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem x:Name="UpdatesItem" Content="{l:Tr Nav_Updates}" Tag="updates">
          <ui:FANavigationViewItem.IconSource><ui:FASymbolIconSource Symbol="Sync" /></ui:FANavigationViewItem.IconSource>
          <ui:FANavigationViewItem.InfoBadge>
            <ui:FAInfoBadge Value="{Binding Updates.Count}" IsVisible="{Binding Updates.Count}" />
          </ui:FANavigationViewItem.InfoBadge>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem Content="{l:Tr Nav_Installed}" Tag="installed">
          <ui:FANavigationViewItem.IconSource><ui:FASymbolIconSource Symbol="AllApps" /></ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
      </ui:FANavigationView.MenuItems>
      <ui:FANavigationView.FooterMenuItems>
        <!-- wgetui's own update: shown only when a newer version exists; invoking it never changes the page
             (SelectsOnInvoked=False, handled in ItemInvoked). Compact pane: icon + accent dot. -->
        <ui:FANavigationViewItem x:Name="AppUpdateItem" SelectsOnInvoked="False"
                                 IsVisible="{Binding AppUpdate.IsVisible}"
                                 ToolTip.Tip="{Binding AppUpdate.ToolTipText}"
                                 AutomationProperties.Name="{Binding AppUpdate.Title}">
          <ui:FANavigationViewItem.Resources>
            <ResourceDictionary>
              <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://wgetui/Themes/AppUpdateItem.axaml" />
              </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
          </ui:FANavigationViewItem.Resources>
          <ui:FANavigationViewItem.IconSource><ui:FASymbolIconSource Symbol="Download" /></ui:FANavigationViewItem.IconSource>
          <ui:FANavigationViewItem.InfoBadge>
            <ui:FAInfoBadge IsVisible="{Binding !#Nav.IsPaneOpen}" />
          </ui:FANavigationViewItem.InfoBadge>
          <StackPanel Spacing="1" Margin="0,6">
            <!-- The pane is 220 px: a longer translation wraps instead of losing its end. The error in the
                 subtitle is trimmed; the tooltip has both lines in full. -->
            <TextBlock Text="{Binding AppUpdate.Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding AppUpdate.Subtitle}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
            <ProgressBar IsVisible="{Binding AppUpdate.IsDownloading}" Value="{Binding AppUpdate.Progress}"
                         IsIndeterminate="{Binding AppUpdate.IsProgressIndeterminate}"
                         Minimum="0" Maximum="100" MinHeight="3" Height="3" Margin="0,4,8,0" />
          </StackPanel>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem Content="{l:Tr Nav_Settings}" Tag="settings">
          <ui:FANavigationViewItem.IconSource><ui:FASymbolIconSource Symbol="Settings" /></ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
      </ui:FANavigationView.FooterMenuItems>
    </ui:FANavigationView>
    <v:QueuePanel Grid.Column="1" DataContext="{Binding Operations}" />
    </Grid>
    <!-- Package details: modal overlay over the whole window (see DetailsOverlay). -->
    <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding Details.IsOpen}" Background="{DynamicResource OverlayBackdrop}">
      <Border Width="640" Margin="24" MaxHeight="760" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="8" ClipToBounds="True"
              Background="{DynamicResource DetailsDialogBackground}" BorderBrush="{DynamicResource DetailsDialogBorder}" BorderThickness="1"
              BoxShadow="0 24 64 0 #80000000">
        <ContentControl Content="{Binding Details.Current}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:PackageDetailsViewModel"><v:PackageDetailsView /></DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>
    </Panel>
  </Grid>
</Window>
