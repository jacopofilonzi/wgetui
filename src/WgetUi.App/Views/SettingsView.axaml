<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:WgetUi.App.ViewModels"
             xmlns:l="using:WgetUi.App.Localization"
             x:Class="WgetUi.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,16,24,16" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Classes="PageTitle" Text="{l:Tr Settings_Title}" />
      <ui:FAInfoBar Severity="Error" IsClosable="False" IsOpen="{Binding SaveFailed}" Message="{l:Tr Settings_SaveFailed}" />
      <StackPanel Spacing="4">
        <TextBlock Classes="RowTitle" Text="{l:Tr Settings_Language}" />
        <ComboBox MinWidth="240" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="RowTitle" Text="{l:Tr Settings_Theme}" />
        <ComboBox MinWidth="240" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="RowTitle" Text="{l:Tr Settings_Agreements}" />
        <CheckBox IsChecked="{Binding AutoAcceptAgreements}" Content="{l:Tr Settings_AutoAccept}" />
        <TextBlock Classes="Secondary" Text="{l:Tr Settings_AutoAcceptHint}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="RowTitle" Text="{l:Tr Settings_Background}" />
        <CheckBox IsChecked="{Binding CloseToTray}" Content="{l:Tr Settings_CloseToTray}" />
        <CheckBox IsChecked="{Binding StartWithWindows}" Content="{l:Tr Settings_StartWithWindows}" />
        <CheckBox IsChecked="{Binding NotifyNewUpdates}" Content="{l:Tr Settings_NotifyNewUpdates}" />
        <CheckBox IsChecked="{Binding RelaunchClosedApps}" Content="{l:Tr Settings_RelaunchClosedApps}" />
        <TextBlock Classes="Secondary" Text="{l:Tr Settings_RelaunchClosedAppsHint}" TextWrapping="Wrap" />
        <CheckBox IsChecked="{Binding AutoUpdatesEnabled}" Content="{l:Tr Settings_AutoUpdatesEnabled}" Margin="0,8,0,0" />
        <TextBlock Classes="Secondary" Text="{l:Tr Settings_AutoUpdatesEnabledHint}" TextWrapping="Wrap" />
        <CheckBox IsChecked="{Binding AutoUpdateOpenApps}" IsEnabled="{Binding AutoUpdatesEnabled}" Content="{l:Tr Settings_AutoUpdateOpenApps}" />
        <TextBlock Classes="Secondary" Text="{l:Tr Settings_AutoUpdateOpenAppsHint}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="RowTitle" Text="{l:Tr Settings_IgnoredUpdates}" />
        <TextBlock Classes="Secondary" Text="{l:Tr Settings_IgnoredUpdatesHint}" TextWrapping="Wrap" />
        <TextBlock Classes="Secondary" Text="{l:Tr Settings_IgnoredUpdatesNone}" IsVisible="{Binding !HasIgnoredUpdates}" Margin="0,4,0,0" />
        <ItemsControl ItemsSource="{Binding IgnoredUpdates}" IsVisible="{Binding HasIgnoredUpdates}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:IgnoredUpdateItemViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Margin="0,4">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="Secondary" Text="{Binding PackageId}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="Version" Text="{Binding Version}" ToolTip.Tip="{Binding Version}" />
                <Button Grid.Column="2" Content="{l:Tr Settings_IgnoredRestore}" Command="{Binding RestoreCommand}" MinWidth="96" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="RowTitle" Text="{l:Tr Settings_About}" />
        <TextBlock Classes="Secondary" Text="{Binding Version, StringFormat='wgetui {0}'}" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <Button Content="{l:Tr Settings_CheckAppUpdatesNow}" Command="{Binding AppUpdate.CheckCommand}" />
            <Button Content="{l:Tr Settings_WhatsNew}" Command="{Binding ShowWhatsNewCommand}" />
          </StackPanel>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding AppUpdate.CheckResult}" />
        </Grid>
        <TextBlock Classes="Secondary" IsVisible="{Binding !AppUpdate.IsSupported}" Text="{l:Tr Settings_AppUpdatesInstalledOnly}" TextWrapping="Wrap" />
        <CheckBox IsChecked="{Binding CheckAppUpdates}" IsEnabled="{Binding AppUpdate.IsSupported}" Content="{l:Tr Settings_CheckAppUpdates}" />
        <TextBlock Classes="Secondary" Text="{l:Tr Settings_CheckAppUpdatesHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <SelectableTextBlock Classes="Secondary" Text="{Binding SettingsFile}" />
        <SelectableTextBlock Classes="Secondary" Text="{Binding LogFile}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
