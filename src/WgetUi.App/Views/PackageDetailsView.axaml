<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:WgetUi.App.ViewModels"
             xmlns:c="using:WgetUi.App.Controls"
             xmlns:l="using:WgetUi.App.Localization"
             x:Class="WgetUi.App.Views.PackageDetailsView"
             x:DataType="vm:PackageDetailsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.FieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Strong">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="HyperlinkButton.Field">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.Tag">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>
  <!-- Header and footer stay put; the body scrolls when the window is short. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header: tile, name, "id · publisher · source", close. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="24,24,24,0">
      <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource PackageTileBackground}" VerticalAlignment="Top">
        <ui:FASymbolIcon Symbol="Library" FontSize="24" Foreground="{DynamicResource PackageTileForeground}" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal">
          <SelectableTextBlock Classes="Secondary" Text="{Binding Id}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Classes="Secondary" Text="·" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding HasPublisher}" />
          <TextBlock Classes="Secondary" Text="{Binding Publisher}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding HasPublisher}" />
          <c:SourceBadge SourceId="{Binding SourceId}" SourceName="{Binding SourceName}" />
        </WrapPanel>
      </StackPanel>
      <Button Grid.Column="2" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
              Command="{Binding CloseCommand}" ToolTip.Tip="{l:Tr Details_Close}" AutomationProperties.Name="{l:Tr Details_Close}">
        <ui:FASymbolIcon Symbol="Dismiss" FontSize="14" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="20" Margin="24,0,24,0">
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
        <TextBlock Classes="Secondary" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" LineHeight="21" />

        <!-- Info card: only the known fields (view model), two per row. -->
        <Border Padding="16,16,0,0" CornerRadius="8" Background="{DynamicResource DetailsCardBackground}" BorderBrush="{DynamicResource DetailsCardBorder}" BorderThickness="1">
          <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DetailsField">
                <StackPanel Spacing="4" Margin="0,0,16,16">
                  <TextBlock Classes="FieldLabel" Text="{Binding Label}" />
                  <HyperlinkButton Classes="Field" Content="{Binding Text}" NavigateUri="{Binding Link}" ToolTip.Tip="{Binding Link}" IsVisible="{Binding HasLink}" />
                  <TextBlock Text="{Binding Text}" Classes.Strong="{Binding IsStrong}" Classes.Secondary="{Binding IsMuted}" IsVisible="{Binding HasText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- Automatic updates: settings saved right away (not an action run after closing). -->
        <StackPanel Spacing="4" IsVisible="{Binding ShowAutoUpdate}">
          <TextBlock Text="{l:Tr Details_AutoUpdate}" FontWeight="SemiBold" Margin="0,0,0,4" />
          <CheckBox IsChecked="{Binding AutoUpdate}">
            <StackPanel>
              <TextBlock Text="{l:Tr Details_AutoUpdateOn}" />
              <TextBlock Classes="Secondary" FontSize="12" Text="{l:Tr Details_AutoUpdateOnHint}" TextWrapping="Wrap" />
            </StackPanel>
          </CheckBox>
          <CheckBox IsChecked="{Binding AutoUpdateForce}" IsEnabled="{Binding AutoUpdate}">
            <StackPanel>
              <TextBlock Text="{l:Tr Details_AutoUpdateForce}" />
              <TextBlock Classes="Secondary" FontSize="12" Text="{l:Tr Details_AutoUpdateForceHint}" TextWrapping="Wrap" />
            </StackPanel>
          </CheckBox>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding HasVersions}">
          <TextBlock Text="{l:Tr Details_Versions}" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding Versions}" MaxHeight="200" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PackageVersionItemViewModel">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8" MinHeight="28">
                  <TextBlock Text="{Binding Version}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" Classes="Tag" Background="{DynamicResource Tag.Latest.Background}" IsVisible="{Binding IsLatest}">
                    <TextBlock Text="{l:Tr Details_Latest}" FontSize="11" Foreground="{DynamicResource Tag.Latest.Foreground}" />
                  </Border>
                  <Border Grid.Column="2" Classes="Tag" Background="{DynamicResource Tag.Installed.Background}" IsVisible="{Binding IsInstalled}">
                    <TextBlock Text="{l:Tr Details_Installed}" FontSize="11" Foreground="{DynamicResource Tag.Installed.Foreground}" />
                  </Border>
                  <Button Grid.Column="4" Content="{l:Tr Details_InstallVersion}" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" FontSize="12" Padding="12,4" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer: ignore on the left, close + primary action on the right. -->
    <Border Grid.Row="2" Margin="0,20,0,0" Padding="24,16" Background="{DynamicResource DetailsFooterBackground}" BorderBrush="{DynamicResource DetailsCardBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Command="{Binding IgnoreCommand}" IsVisible="{Binding ShowIgnore}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ui:FAFontIcon Glyph="&#xED1A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
            <TextBlock Text="{Binding IgnoreText}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Content="{l:Tr Details_Close}" Command="{Binding CloseCommand}" MinWidth="96" />
        <Button Grid.Column="3" Classes="accent" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsVisible="{Binding ShowPrimary}" MinWidth="96" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
