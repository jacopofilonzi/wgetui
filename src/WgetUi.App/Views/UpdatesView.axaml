<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:WgetUi.App.ViewModels"
             xmlns:c="using:WgetUi.App.Controls"
             xmlns:l="using:WgetUi.App.Localization"
             x:Class="WgetUi.App.Views.UpdatesView"
             x:DataType="vm:UpdatesViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24,16,24,16" RowSpacing="12">
    <TextBlock Grid.Row="0" Classes="PageTitle" Text="{l:Tr Updates_Title}" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <ToggleSwitch Grid.Column="0" IsChecked="{Binding IncludeUnknown}" IsVisible="{Binding ShowIncludeUnknownToggle}"
                    OnContent="{l:Tr Updates_ShowUnknown}" OffContent="{l:Tr Updates_ShowUnknown}" />
      <Button Grid.Column="1" Content="{l:Tr Updates_Refresh}" Command="{Binding RefreshCommand}" />
      <Button Grid.Column="2" Classes="accent" Content="{l:Tr Updates_UpgradeAll}" Command="{Binding UpgradeAllCommand}" />
    </Grid>
    <ProgressBar Grid.Row="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    <StackPanel Grid.Row="3" Spacing="8">
      <ui:FAInfoBar Severity="Warning" IsClosable="False" IsOpen="{Binding HasError}" Title="{l:Tr Errors_SomeFailed}" Message="{Binding ErrorMessage}" />
      <ui:FAInfoBar Severity="Warning" IsClosable="False" IsOpen="{Binding HasNotice}" Message="{Binding Notice}" />
    </StackPanel>
    <Panel Grid.Row="4">
      <TextBlock Classes="Secondary" Text="{l:Tr Updates_None}" IsVisible="{Binding ShowNone}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ListBox ItemsSource="{Binding Upgrades}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PackageRowViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16" Margin="0,4">
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Classes="RowTitle" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="Secondary" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Panel>
                  <TextBlock Text="{Binding Version}" IsVisible="{Binding !IsVersionUnknown}" />
                  <TextBlock Classes="Secondary" Text="{l:Tr Version_Unknown}" IsVisible="{Binding IsVersionUnknown}" />
                </Panel>
                <TextBlock Classes="Secondary" Text="→" />
                <TextBlock Classes="RowTitle" Text="{Binding AvailableVersion}" />
              </StackPanel>
              <c:SourceBadge Grid.Column="2" SourceId="{Binding SourceId}" SourceName="{Binding SourceName}" />
              <Button Grid.Column="3" Content="{l:Tr Updates_Upgrade}" Command="{Binding ActCommand}" IsVisible="{Binding CanAct}" MinWidth="96" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </Grid>
</UserControl>
