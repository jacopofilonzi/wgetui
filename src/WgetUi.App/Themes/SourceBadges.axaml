<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Source badge look, per source id ("SourceBadge.<sourceId>.*"). A source without entries uses
       "SourceBadge.default.*", so new managers/sources get a badge with no code change; add entries here
       to give them their own colour and icon. Icons are FASymbol names. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="SourceBadge.winget.Background" Color="#FFDCEBFB" />
      <SolidColorBrush x:Key="SourceBadge.winget.Foreground" Color="#FF0F4C8A" />
      <SolidColorBrush x:Key="SourceBadge.msstore.Background" Color="#FFE7DEF8" />
      <SolidColorBrush x:Key="SourceBadge.msstore.Foreground" Color="#FF5B2A9E" />
      <SolidColorBrush x:Key="SourceBadge.local.Background" Color="#FFF6EAD3" />
      <SolidColorBrush x:Key="SourceBadge.local.Foreground" Color="#FF7A4B00" />
      <SolidColorBrush x:Key="SourceBadge.default.Background" Color="#FFE6E6E6" />
      <SolidColorBrush x:Key="SourceBadge.default.Foreground" Color="#FF404040" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="SourceBadge.winget.Background" Color="#FF16365A" />
      <SolidColorBrush x:Key="SourceBadge.winget.Foreground" Color="#FFA9D1FF" />
      <SolidColorBrush x:Key="SourceBadge.msstore.Background" Color="#FF3A2660" />
      <SolidColorBrush x:Key="SourceBadge.msstore.Foreground" Color="#FFD7C2FF" />
      <SolidColorBrush x:Key="SourceBadge.local.Background" Color="#FF4A3713" />
      <SolidColorBrush x:Key="SourceBadge.local.Foreground" Color="#FFF5D08A" />
      <SolidColorBrush x:Key="SourceBadge.default.Background" Color="#FF3A3A3A" />
      <SolidColorBrush x:Key="SourceBadge.default.Foreground" Color="#FFDDDDDD" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <x:String x:Key="SourceBadge.winget.Icon">Library</x:String>
  <x:String x:Key="SourceBadge.msstore.Icon">Shop</x:String>
  <x:String x:Key="SourceBadge.local.Icon">Home</x:String>
  <x:String x:Key="SourceBadge.default.Icon">Tag</x:String>
</ResourceDictionary>
