<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- App colours not covered by FluentAvalonia's brushes (Light/Dark). Views use them through DynamicResource. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="InfoButtonForeground" Color="#FF2563EB" />
      <SolidColorBrush x:Key="OverlayBackdrop" Color="#66000000" />
      <SolidColorBrush x:Key="DetailsDialogBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="DetailsDialogBorder" Color="#FFD6D6D6" />
      <SolidColorBrush x:Key="DetailsFooterBackground" Color="#FFF3F3F3" />
      <SolidColorBrush x:Key="PackageTileBackground" Color="#FFE6E6E6" />
      <SolidColorBrush x:Key="PackageTileForeground" Color="#FF404040" />
      <SolidColorBrush x:Key="DetailsCardBackground" Color="#FFF7F7F7" />
      <SolidColorBrush x:Key="DetailsCardBorder" Color="#FFE3E3E3" />
      <SolidColorBrush x:Key="Tag.Latest.Background" Color="#FFE7E3FF" />
      <SolidColorBrush x:Key="Tag.Latest.Foreground" Color="#FF4B3A9E" />
      <SolidColorBrush x:Key="Tag.Installed.Background" Color="#FFE6E6E6" />
      <SolidColorBrush x:Key="Tag.Installed.Foreground" Color="#FF404040" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="InfoButtonForeground" Color="#FF60A5FA" />
      <SolidColorBrush x:Key="OverlayBackdrop" Color="#8C000000" />
      <SolidColorBrush x:Key="DetailsDialogBackground" Color="#FF2B2B2B" />
      <SolidColorBrush x:Key="DetailsDialogBorder" Color="#FF3D3D3D" />
      <SolidColorBrush x:Key="DetailsFooterBackground" Color="#FF202020" />
      <SolidColorBrush x:Key="PackageTileBackground" Color="#FF3A3A3A" />
      <SolidColorBrush x:Key="PackageTileForeground" Color="#FFE4E4E4" />
      <SolidColorBrush x:Key="DetailsCardBackground" Color="#FF252525" />
      <SolidColorBrush x:Key="DetailsCardBorder" Color="#FF353535" />
      <SolidColorBrush x:Key="Tag.Latest.Background" Color="#FF2E2A4F" />
      <SolidColorBrush x:Key="Tag.Latest.Foreground" Color="#FFC9BFFF" />
      <SolidColorBrush x:Key="Tag.Installed.Background" Color="#FF3A3A3A" />
      <SolidColorBrush x:Key="Tag.Installed.Foreground" Color="#FFE4E4E4" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
