<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- App colours not covered by FluentAvalonia's brushes (Light/Dark). Views use them through DynamicResource. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="InfoButtonForeground" Color="#FF2563EB" />
      <SolidColorBrush x:Key="OverlayBackdrop" Color="#66000000" />
      <SolidColorBrush x:Key="DetailsDialogBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="DetailsDialogBorder" Color="#FFD6D6D6" />
      <SolidColorBrush x:Key="DetailsFooterBackground" Color="#FFF3F3F3" />
      <SolidColorBrush x:Key="PackageTileBackground" Color="#FFE6E6E6" />
      <SolidColorBrush x:Key="PackageTileForeground" Color="#FF404040" />
      <SolidColorBrush x:Key="DetailsCardBackground" Color="#FFF7F7F7" />
      <SolidColorBrush x:Key="DetailsCardBorder" Color="#FFE3E3E3" />
      <SolidColorBrush x:Key="Tag.Latest.Background" Color="#FFE7E3FF" />
      <SolidColorBrush x:Key="Tag.Latest.Foreground" Color="#FF4B3A9E" />
      <SolidColorBrush x:Key="Tag.Installed.Background" Color="#FFE6E6E6" />
      <SolidColorBrush x:Key="Tag.Installed.Foreground" Color="#FF404040" />
      <SolidColorBrush x:Key="AutoUpdateOffForeground" Color="#FF767676" />
      <SolidColorBrush x:Key="AutoUpdateOnForeground" Color="#FF5B46C9" />
      <SolidColorBrush x:Key="AutoUpdateOnBackground" Color="#FFEEEBFF" />
      <SolidColorBrush x:Key="AutoUpdateOnBorder" Color="#FFC9C0F5" />
      <SolidColorBrush x:Key="AutoUpdateForcedBackground" Color="#FFF59E0B" />
      <SolidColorBrush x:Key="AutoUpdateForcedForeground" Color="#FF1A1A1A" />
      <!-- Import status pills (always with their text). -->
      <SolidColorBrush x:Key="ImportStatus.Checking.Background" Color="#FFEDEDED" />
      <SolidColorBrush x:Key="ImportStatus.Checking.Foreground" Color="#FF5C5C5C" />
      <SolidColorBrush x:Key="ImportStatus.ToInstall.Background" Color="#FFE7E3FF" />
      <SolidColorBrush x:Key="ImportStatus.ToInstall.Foreground" Color="#FF4B3A9E" />
      <SolidColorBrush x:Key="ImportStatus.Installed.Background" Color="#FFDFF3E4" />
      <SolidColorBrush x:Key="ImportStatus.Installed.Foreground" Color="#FF1E6B34" />
      <SolidColorBrush x:Key="ImportStatus.Problem.Background" Color="#FFFDE7E9" />
      <SolidColorBrush x:Key="ImportStatus.Problem.Foreground" Color="#FFA4262C" />
      <SolidColorBrush x:Key="ImportStatus.Unavailable.Background" Color="#FFFFF4CE" />
      <SolidColorBrush x:Key="ImportStatus.Unavailable.Foreground" Color="#FF7A5200" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="InfoButtonForeground" Color="#FF60A5FA" />
      <SolidColorBrush x:Key="OverlayBackdrop" Color="#8C000000" />
      <SolidColorBrush x:Key="DetailsDialogBackground" Color="#FF2B2B2B" />
      <SolidColorBrush x:Key="DetailsDialogBorder" Color="#FF3D3D3D" />
      <SolidColorBrush x:Key="DetailsFooterBackground" Color="#FF202020" />
      <SolidColorBrush x:Key="PackageTileBackground" Color="#FF3A3A3A" />
      <SolidColorBrush x:Key="PackageTileForeground" Color="#FFE4E4E4" />
      <SolidColorBrush x:Key="DetailsCardBackground" Color="#FF252525" />
      <SolidColorBrush x:Key="DetailsCardBorder" Color="#FF353535" />
      <SolidColorBrush x:Key="Tag.Latest.Background" Color="#FF2E2A4F" />
      <SolidColorBrush x:Key="Tag.Latest.Foreground" Color="#FFC9BFFF" />
      <SolidColorBrush x:Key="Tag.Installed.Background" Color="#FF3A3A3A" />
      <SolidColorBrush x:Key="Tag.Installed.Foreground" Color="#FFE4E4E4" />
      <SolidColorBrush x:Key="AutoUpdateOffForeground" Color="#FF8A8A8A" />
      <SolidColorBrush x:Key="AutoUpdateOnForeground" Color="#FFA594F9" />
      <SolidColorBrush x:Key="AutoUpdateOnBackground" Color="#FF2E2A4F" />
      <SolidColorBrush x:Key="AutoUpdateOnBorder" Color="#FF4A4380" />
      <SolidColorBrush x:Key="AutoUpdateForcedBackground" Color="#FFF59E0B" />
      <SolidColorBrush x:Key="AutoUpdateForcedForeground" Color="#FF1A1A1A" />
      <!-- Import status pills (always with their text). -->
      <SolidColorBrush x:Key="ImportStatus.Checking.Background" Color="#FF3A3A3A" />
      <SolidColorBrush x:Key="ImportStatus.Checking.Foreground" Color="#FFC8C8C8" />
      <SolidColorBrush x:Key="ImportStatus.ToInstall.Background" Color="#FF2E2A4F" />
      <SolidColorBrush x:Key="ImportStatus.ToInstall.Foreground" Color="#FFC9BFFF" />
      <SolidColorBrush x:Key="ImportStatus.Installed.Background" Color="#FF1F3A27" />
      <SolidColorBrush x:Key="ImportStatus.Installed.Foreground" Color="#FF9BE0AE" />
      <SolidColorBrush x:Key="ImportStatus.Problem.Background" Color="#FF442726" />
      <SolidColorBrush x:Key="ImportStatus.Problem.Foreground" Color="#FFFFB3B0" />
      <SolidColorBrush x:Key="ImportStatus.Unavailable.Background" Color="#FF433519" />
      <SolidColorBrush x:Key="ImportStatus.Unavailable.Foreground" Color="#FFFFD98A" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
