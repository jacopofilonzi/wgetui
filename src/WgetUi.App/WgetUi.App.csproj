<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia + FluentAvalonia desktop shell (MVVM with CommunityToolkit.Mvvm, DI). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>WgetUi.App</RootNamespace>
    <AssemblyName>wgetui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Generated by `make icons` (tools/WgetUi.IconGen); the window icon uses the same file. -->
    <ApplicationIcon>Assets\wgetui.ico</ApplicationIcon>
    <!-- LibraryImport (source-generated P/Invoke) in Platform/Windows needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WgetUi.Core\WgetUi.Core.csproj" />
    <ProjectReference Include="..\WgetUi.Managers.WinGet\WgetUi.Managers.WinGet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />
  </ItemGroup>

  <!-- SkiaSharp and HarfBuzzSharp ship native .pdb symbols next to their DLLs in runtimes/win-x64/native;
       the SDK publishes every file there, and symbols are never bundled into the single-file exe, so ~105 MB
       of debug symbols would sit loose in publish/. DebugType=None only covers our own symbols. -->
  <Target Name="ExcludePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
